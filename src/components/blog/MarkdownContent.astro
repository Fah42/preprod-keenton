<article class="markdown-content">
  <slot />
</article>

<style>
  .markdown-content :global(h2) { margin-top: 3rem; color: var(--color-ink); font-size: 1.65rem; font-weight: 700; line-height: 1.25; }
  .markdown-content :global(h3) { margin-top: 2.25rem; color: var(--color-ink); font-size: 1.25rem; font-weight: 700; }
  .markdown-content :global(h4) { margin-top: 1.75rem; color: var(--color-ink); font-size: 1.1rem; font-weight: 700; }
  .markdown-content :global(p), .markdown-content :global(li) { color: var(--color-ink-secondary); font-size: 1.05rem; line-height: 1.85; }
  .markdown-content :global(p) { margin-top: 1.25rem; }
  .markdown-content :global(ul), .markdown-content :global(ol) { margin: 1.25rem 0 0 1.5rem; }
  .markdown-content :global(ul) { list-style: disc; }
  .markdown-content :global(ol) { list-style: decimal; }
  .markdown-content :global(strong) { color: var(--color-ink); }
  .markdown-content :global(a) { color: var(--post-accent); text-decoration: underline; }
  .markdown-content :global(blockquote) { margin-top: 2rem; border-left: 3px solid var(--post-accent); background: var(--color-surface-alt); padding: 1.25rem 1.5rem; }
  .markdown-content :global(img) { display: block; max-width: 100%; height: auto; margin: 2rem auto 0; border-radius: 0.85rem; border: 1px solid var(--color-line); }
  .markdown-content :global(a > img) { transition: opacity 180ms ease; }
  .markdown-content :global(a:hover > img) { opacity: 0.88; }
  .markdown-content :global(figure) { margin-top: 2rem; }
  .markdown-content :global(figure img) { margin-top: 0; }
  .markdown-content :global(figcaption) { margin-top: 0.75rem; color: var(--color-ink-secondary); font-size: 0.85rem; line-height: 1.5; text-align: center; }
  .markdown-content :global(table) { display: block; width: 100%; margin-top: 2rem; overflow-x: auto; border: 1px solid var(--color-line); border-radius: 0.75rem; border-collapse: separate; border-spacing: 0; }
  .markdown-content :global(th), .markdown-content :global(td) { min-width: 9rem; border-right: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: 0.8rem 1rem; color: var(--color-ink-secondary); font-size: 0.92rem; line-height: 1.55; text-align: left; vertical-align: top; }
  .markdown-content :global(th) { background: var(--color-surface-alt); color: var(--color-ink); font-weight: 700; }
  .markdown-content :global(tr > :last-child) { border-right: 0; }
  .markdown-content :global(tbody tr:last-child > *) { border-bottom: 0; }
  .markdown-content :global(pre) { margin-top: 2rem; overflow-x: auto; border-radius: 0.75rem; background: var(--color-ink); padding: 1.25rem; color: white; font-size: 0.9rem; line-height: 1.65; }
  .markdown-content :global(:not(pre) > code) { border-radius: 0.3rem; background: var(--color-surface-alt); padding: 0.15rem 0.35rem; color: var(--color-ink); font-size: 0.92em; }
  .markdown-content :global(iframe), .markdown-content :global(video) { display: block; width: 100%; max-width: 100%; margin-top: 2rem; border: 0; border-radius: 0.85rem; }
  /* Separateurs de section (--- en Markdown) : trait discret aux couleurs du
     site plutot que le hr par defaut du navigateur. */
  .markdown-content :global(hr) { margin-top: 3rem; border: 0; border-top: 1px solid var(--color-line); }
  .markdown-content :global(hr + h2) { margin-top: 3rem; }
</style>
