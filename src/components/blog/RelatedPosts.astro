---
// Section blog partagee par l'accueil et les pages d'expertise. Le contenu
// peut etre filtre en amont, mais la presentation reste strictement identique.
import ArticleCard from './ArticleCard.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';

const {
	posts = [],
	eyebrow = 'Le blog',
	title = 'Nos derniers articles',
	allLabel = 'Tous les articles',
} = Astro.props;
---

{posts.length > 0 && (
	<Section
		{eyebrow}
		{title}
		intro="Des analyses et des méthodes issues des sujets que nous rencontrons sur le terrain."
		theme="muted"
		spacing="tight"
		class="border-y border-line"
	>
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => (
				<ArticleCard post={post} showTopline={false} alwaysAccent={true} />
			))}
		</div>
		<div class="mt-10">
			<Button href="/blog" variant="outline">
				{allLabel}
			</Button>
		</div>
	</Section>
)}
