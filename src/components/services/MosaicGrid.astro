---
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import PlaceholderVisual from '../ui/PlaceholderVisual.astro';
import TechnologyLogos from './TechnologyLogos.astro';
import TechnologySolutionsStrip from './TechnologySolutionsStrip.astro';
import OptimizedImage from '../ui/OptimizedImage.astro';
import FlipDetailCard from './FlipDetailCard.astro';

const {
	eyebrow,
	title,
	body,
	items = [],
	image,
	layout,
	itemsDisplay = 'cards',
	showIllustration = false,
	illustrationIcon,
	imagePlacement = 'side',
	reverse = false,
	technologyTitle,
	technologyDescription,
	technologyDisplay = 'inline',
	technologyPlacement = 'after',
	technologies = [],
} = Astro.props;
const showTechnologyTiles = technologyDisplay === 'tiles' && technologies.length > 0;
const showTechnologyTilesBeforeCards = showTechnologyTiles && technologyPlacement === 'before';
const showCards = itemsDisplay === 'cards';
const displayIllustration = showIllustration && showCards;
const imageAboveCards = displayIllustration && image && imagePlacement === 'top';
const sideIllustration = displayIllustration && !imageAboveCards;
const gridLayout = sideIllustration && image
	? 'md:grid-cols-2'
	: layout === 'four'
		? 'xl:grid-cols-4'
		: layout === 'six' || layout === 'nine'
			? 'xl:grid-cols-3'
			: 'md:grid-cols-2';
const compactCards = layout === 'four' || layout === 'six' || layout === 'nine';
---

<section class="bg-surface-alt py-16 md:py-24">
	<Container>
		<header class:list={[technologies.length > 0 && !showTechnologyTiles ? 'max-w-none' : 'max-w-5xl']}>
			{eyebrow && <h2 class="font-mono text-3xl font-semibold tracking-[-0.04em] text-[var(--cat-accent)] md:text-4xl">{eyebrow}</h2>}
			<h3 class="mt-3 text-xl font-semibold text-ink md:text-2xl">{title}</h3>
			{technologies.length > 0 && !showTechnologyTiles ? (
				<div class="mt-5 leading-relaxed text-ink-secondary">
					<span>{body}</span>
					<TechnologyLogos title={technologyTitle} items={technologies} />
				</div>
			) : (
				<p class="mt-5 leading-relaxed text-ink-secondary">{body}</p>
			)}
		</header>
		{showTechnologyTilesBeforeCards && (
			<TechnologySolutionsStrip
				title={technologyTitle}
				description={technologyDescription}
				items={technologies}
				repeatHeaderAfterTiles
			/>
		)}
		<div class:list={[
			showTechnologyTilesBeforeCards ? 'mt-8 md:mt-10' : 'mt-10',
			sideIllustration && 'grid gap-4 lg:items-center',
			sideIllustration && image && 'lg:grid-cols-2',
			sideIllustration && !image && (reverse ? 'lg:grid-cols-[minmax(0,7fr)_minmax(0,3fr)]' : 'lg:grid-cols-[minmax(0,3fr)_minmax(0,7fr)]'),
		]}>
			{displayIllustration && (
				<div class:list={[
					reverse && sideIllustration && 'lg:order-2',
					imageAboveCards && 'mx-auto w-full max-w-[800px]',
				]}>
					{image ? (
						<OptimizedImage
							src={image.src}
							alt={image.alt}
							width={800}
							layout="constrained"
							fit="contain"
							loading="lazy"
							decoding="async"
							class="mx-auto h-auto w-full object-contain"
						/>
					) : (
						<PlaceholderVisual icon={illustrationIcon} />
					)}
				</div>
			)}
			{showCards ? (
				<div class:list={[
					'grid gap-4 md:grid-cols-2',
					gridLayout,
					imageAboveCards && 'mt-10',
					reverse && sideIllustration && 'lg:order-1',
				]}>
					{
						items.map((item) => item.help ? (
							<FlipDetailCard item={item} variant="mosaic" compact={compactCards} />
						) : (
							<article class:list={[
								'relative flex flex-col rounded-xl border border-line bg-surface transition duration-200 hover:z-20 focus-within:z-20',
								compactCards ? 'h-full p-4 md:p-5 hover:-translate-y-1 hover:scale-[1.02] hover:border-[var(--cat-accent)] hover:ring-1 hover:ring-[var(--cat-accent)] hover:shadow-lg' : 'p-7 md:p-8',
							]}>
								<div class="h-0.5 w-10 bg-[var(--cat-accent)]"></div>
								{item.icon && <Icon name={item.icon} class:list={[compactCards ? 'mt-5 h-6 w-6' : 'mt-8 h-7 w-7', 'text-[var(--cat-accent)]']} />}
								<h3 class:list={[compactCards ? 'mt-4 text-lg' : 'mt-5 text-xl', 'font-semibold text-ink']}>{item.title}</h3>
								<p class="mt-3 max-w-md text-base leading-relaxed text-ink-secondary">{item.text}</p>
							</article>
						))
					}
				</div>
			) : (
				<ul class="grid gap-x-12 gap-y-5 md:grid-cols-2">
					{items.map((item) => (
						<li class="flex gap-3 text-base leading-relaxed text-ink-secondary">
							<span class="shrink-0 font-semibold text-[var(--cat-accent)]" aria-hidden="true">✓</span>
							<div>
								<h3 class="font-semibold text-ink">{item.title}</h3>
								<p class="mt-1">{item.text}</p>
							</div>
						</li>
					))}
				</ul>
			)}
		</div>
		{showTechnologyTiles && !showTechnologyTilesBeforeCards && (
			<TechnologySolutionsStrip
				title={technologyTitle}
				description={technologyDescription}
				items={technologies}
			/>
		)}
	</Container>
</section>
