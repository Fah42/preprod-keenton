---
import AlternatingFeature from '../sections/AlternatingFeature.astro';
import CapabilityGrid from './CapabilityGrid.astro';
import ProcessBlock from './ProcessBlock.astro';
import DecisionPanel from './DecisionPanel.astro';
import SpotlightPanel from './SpotlightPanel.astro';
import ChecklistBlock from './ChecklistBlock.astro';
import MosaicGrid from './MosaicGrid.astro';
import CloudProvidersStrip from './CloudProvidersStrip.astro';

const {
	type = 'split',
	reverse = false,
	tone = 0,
	sectionId,
	showCloudProviders = false,
	...block
} = Astro.props;
---

<div
	id={sectionId}
	class="service-block scroll-mt-32 border-b border-[color-mix(in_srgb,var(--cat-accent)_16%,transparent)]"
	data-service-type={type}
	data-section-tone={tone}
	data-toc-section={sectionId ? '' : undefined}
>
	{type === 'capabilities' && <CapabilityGrid {...block} reverse={reverse} />}
	{type === 'process' && <ProcessBlock {...block} />}
	{type === 'decision' && <DecisionPanel {...block} />}
	{type === 'spotlight' && <SpotlightPanel {...block} />}
	{type === 'checklist' && <ChecklistBlock {...block} />}
	{type === 'mosaic' && <MosaicGrid {...block} reverse={reverse} />}
	{type === 'split' && (
		<AlternatingFeature {...block} reverse={reverse}>
			{showCloudProviders && <CloudProvidersStrip />}
		</AlternatingFeature>
	)}
</div>
