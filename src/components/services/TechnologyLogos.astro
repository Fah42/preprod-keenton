---
import {
	siAnsible,
	siAmazonwebservices,
	siAmazons3,
	siArgo,
	siCilium,
	siCisco,
	siCloudflare,
	siDebian,
	siFlux,
	siFortinet,
	siGrafana,
	siGooglecloud,
	siHp,
	siKubernetes,
	siJira,
	siJirasoftware,
	siNginx,
	siNutanix,
	siOvh,
	siPlesk,
	siPfsense,
	siProxmox,
	siPuppet,
	siScaleway,
	siTerraform,
	siTeamviewer,
	siSupermicro,
	siUbiquiti,
	siVeeam,
	siVmware,
	siWordpress,
} from 'simple-icons';

const brandIcons = {
	nutanix: siNutanix,
	debian: siDebian,
	puppet: siPuppet,
	wordpress: siWordpress,
	plesk: siPlesk,
	nginx: siNginx,
	kubernetes: siKubernetes,
	argocd: siArgo,
	fluxcd: siFlux,
	cilium: siCilium,
	'amazon-s3': siAmazons3,
	veeam: siVeeam,
	aws: siAmazonwebservices,
	'google-cloud': siGooglecloud,
	scaleway: siScaleway,
	ovhcloud: siOvh,
	fortinet: siFortinet,
	cisco: siCisco,
	pfsense: siPfsense,
	hp: siHp,
	supermicro: siSupermicro,
	ubiquiti: siUbiquiti,
	proxmox: siProxmox,
	vmware: siVmware,
	terraform: siTerraform,
	ansible: siAnsible,
	cloudflare: siCloudflare,
	grafana: siGrafana,
	'jira-service-management': siJira,
	jira: siJirasoftware,
	teamviewer: siTeamviewer,
};

const brandMonograms = {
	foreman: 'FM',
	dokploy: 'DK',
	velero: 'VL',
	hycu: 'HYCU',
	ibm: 'IBM',
	netgate: 'NG',
	'cisco-meraki': 'MRK',
	'hp-aruba': 'ARUBA',
	'microsoft-teams-phone': 'TEAMS',
	'3cx': '3CX',
	'microsoft-hyper-v': 'HV',
	'microsoft-azure': 'AZ',
	zabbix: 'ZBX',
};

const brandViewBoxes = {
	supermicro: '0 5.5 24 13',
};

const {
	title = 'Technologies maîtrisées',
	items = [],
} = Astro.props;

const logoWidth = 3;
const expandedLogoWidth = logoWidth * 2;
const expandedRowWidth = `${items.length * logoWidth + Math.max(items.length - 1, 0) * 0.375 + expandedLogoWidth - logoWidth}rem`;
---

{items.length > 0 && (
	<ul
		class="relative z-30 ml-2 inline-flex h-8 translate-y-1 flex-nowrap items-center gap-1.5 overflow-visible align-baseline"
		style={`width: ${expandedRowWidth}`}
		aria-label={title}
	>
		{items.map((item) => {
			const icon = brandIcons[item.icon];
			const monogram = brandMonograms[item.icon];
			const viewBox = brandViewBoxes[item.icon] ?? '0 0 24 24';

			return (
				<li
					class="group relative h-8 w-12 shrink-0 overflow-visible transition-[width] duration-200 ease-out hover:z-30 hover:w-24 motion-reduce:transition-none"
				>
					<span class="absolute top-1/2 left-0 flex h-8 w-12 -translate-y-1/2 items-center justify-center rounded-md border border-[color-mix(in_srgb,var(--cat-accent)_22%,var(--color-line))] bg-white text-[var(--cat-accent)] shadow-sm transition-[width,height,box-shadow] duration-200 ease-out group-hover:h-16 group-hover:w-24 group-hover:shadow-lg motion-reduce:transition-none">
						<span class="sr-only">{item.name} — {item.role}</span>
						{icon && (
							<svg
								viewBox={viewBox}
								class:list={[
									'relative z-10 fill-current transition-transform duration-200 ease-out group-hover:scale-200 motion-reduce:transform-none',
									item.icon === 'cisco' ? 'h-6 w-10' : 'h-5 w-10',
								]}
								aria-hidden="true"
							>
								<path d={icon.path} />
							</svg>
						)}
						{!icon && monogram && (
							<span
								class:list={[
									'relative z-10 leading-none font-bold tracking-[-0.08em] transition-transform duration-200 ease-out group-hover:scale-200 motion-reduce:transform-none',
									monogram.length > 2 ? 'text-[0.48rem]' : 'text-[0.62rem]',
								]}
								aria-hidden="true"
							>
								{monogram}
							</span>
						)}
					</span>
					<span
						class="pointer-events-none absolute top-[calc(100%+1.375rem)] left-1/2 z-20 -translate-x-1/2 whitespace-nowrap rounded-md bg-ink px-2.5 py-1.5 text-[0.8rem] leading-none font-semibold text-white opacity-0 shadow-sm transition-opacity duration-150 group-hover:opacity-100"
						aria-hidden="true"
					>
						{item.name}
					</span>
				</li>
			);
		})}
	</ul>
)}
