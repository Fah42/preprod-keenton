---
import {
	siApple,
	siLinux,
} from 'simple-icons';
import MethodologiesDivider from './MethodologiesDivider.astro';

const systems = [
	{ name: 'Windows', type: 'windows', color: '#0078D4' },
	{ name: 'macOS', icon: siApple, color: '#000000' },
	{ name: 'Linux', icon: siLinux, color: '#111111' },
];
---

<aside class="mt-10 md:mt-12" aria-label="Systèmes maîtrisés">
	<header class="text-center">
		<div class="flex items-center gap-4">
			<span class="h-px flex-1 bg-linear-to-r from-transparent to-[color-mix(in_srgb,var(--cat-accent)_45%,transparent)]" aria-hidden="true"></span>
			<h2 class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-[var(--cat-accent)]">
				Systèmes maîtrisés
			</h2>
			<span class="h-px flex-1 bg-linear-to-l from-transparent to-[color-mix(in_srgb,var(--cat-accent)_45%,transparent)]" aria-hidden="true"></span>
		</div>
		<p class="mx-auto mt-3 max-w-2xl text-sm text-ink-secondary">
			Windows, macOS et Linux, administrés avec le même niveau d’exigence.
		</p>
	</header>

	<ul class="-mx-6 mt-5 flex snap-x gap-3 overflow-x-auto px-6 pb-1 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0 md:pb-0" aria-label="Systèmes d’exploitation maîtrisés">
		{
				systems.map((system) => (
					<li class="group w-48 shrink-0 snap-start rounded-xl bg-line p-[2px] md:w-auto">
					<div class="flex h-16 items-center justify-center gap-3 rounded-[calc(0.75rem-2px)] bg-white px-4">
						{system.type === 'windows' ? (
							<svg
								viewBox="0 0 24 24"
								class="h-8 w-8 shrink-0 fill-current text-[color-mix(in_srgb,var(--cat-accent)_65%,white)] transition-colors duration-200 group-hover:text-[var(--brand-color)] motion-reduce:transition-none"
								style={`--brand-color: ${system.color}`}
								aria-hidden="true"
							>
								<path d="M2 3.4 10.5 2.2v8.9H2V3.4Zm9.5-1.35L22 0.55V11.1H11.5V2.05ZM2 12.1h8.5V21L2 19.8v-7.7Zm9.5 0H22v10.55l-10.5-1.5V12.1Z" />
							</svg>
						) : (
							<svg
								viewBox="0 0 24 24"
								class="h-8 w-8 shrink-0 fill-current text-[color-mix(in_srgb,var(--cat-accent)_65%,white)] transition-colors duration-200 group-hover:text-[var(--brand-color)] motion-reduce:transition-none"
								style={`--brand-color: ${system.color}`}
								aria-hidden="true"
							>
								<path d={system.icon.path} />
							</svg>
						)}
						<strong class="text-sm leading-tight font-semibold text-ink">{system.name}</strong>
					</div>
				</li>
			))
		}
	</ul>
	<MethodologiesDivider />
</aside>
