---
import OptimizedImage from '../ui/OptimizedImage.astro';
import MethodologiesDivider from './MethodologiesDivider.astro';
import threeCxLogo from '../../assets/images/technologies/3cx.png';
import hyperVLogo from '../../assets/images/technologies/microsoft-hyper-v.png';
import teamsPhoneLogo from '../../assets/images/technologies/microsoft-teams-phone.png';
import nutanixLogo from '../../assets/images/technologies/nutanix.svg';
import proxmoxLogo from '../../assets/images/technologies/proxmox-ve.svg';
import vmwareLogo from '../../assets/images/technologies/vmware.svg';

const {
	title = 'Solutions maîtrisées',
	items = [],
	repeatHeaderAfterTiles = false,
} = Astro.props;

const solutionLogos = {
	'3cx': {
		src: threeCxLogo,
		className: 'h-14 w-28',
		width: 144,
	},
	'microsoft-teams-phone': {
		src: teamsPhoneLogo,
		className: 'h-16 w-16',
		width: 64,
	},
	nutanix: {
		src: nutanixLogo,
		className: 'h-14 w-20',
		width: 80,
		isSvg: true,
	},
	proxmox: {
		src: proxmoxLogo,
		className: 'h-14 w-14',
		width: 56,
		isSvg: true,
	},
	vmware: {
		src: vmwareLogo,
		className: 'h-14 w-14',
		width: 56,
		isSvg: true,
	},
	'microsoft-hyper-v': {
		src: hyperVLogo,
		className: 'h-14 w-36',
		width: 180,
	},
};

const fourColumns = items.length === 4;
const headingId = `technology-solutions-${title
	.toLowerCase()
	.normalize('NFD')
	.replace(/[\u0300-\u036f]/g, '')
	.replace(/[^a-z0-9]+/g, '-')
	.replace(/^-|-$/g, '')}`;
---

{items.length > 0 && (
	<aside class="mt-10 md:mt-12" aria-labelledby={headingId}>
		<header class="text-center">
			<div class="flex items-center gap-4">
				<span class="h-px flex-1 bg-linear-to-r from-transparent to-[color-mix(in_srgb,var(--cat-accent)_45%,transparent)]" aria-hidden="true"></span>
				<h3 id={headingId} class="shrink-0 whitespace-nowrap font-mono text-xs font-medium uppercase tracking-[0.2em] text-[var(--cat-accent)]">
					{title}
				</h3>
				<span class="h-px flex-1 bg-linear-to-l from-transparent to-[color-mix(in_srgb,var(--cat-accent)_45%,transparent)]" aria-hidden="true"></span>
			</div>
		</header>

		<ul class:list={['mt-6 grid gap-4 sm:grid-cols-2', fourColumns && 'xl:grid-cols-4']} aria-label={title}>
			{items.map((item) => {
				const logo = solutionLogos[item.icon];

				return (
					<li class:list={[
						'group flex min-h-28 items-center gap-5 rounded-2xl border border-[color-mix(in_srgb,var(--cat-accent)_55%,var(--color-line))] bg-white px-6 py-5 transition duration-200 hover:-translate-y-1 hover:border-[var(--cat-accent)] hover:ring-1 hover:ring-[var(--cat-accent)] hover:shadow-lg motion-reduce:transform-none motion-reduce:transition-none md:min-h-32 md:gap-7 md:px-8',
						fourColumns && 'xl:flex-col xl:justify-center xl:gap-4 xl:px-5 xl:text-center',
						!logo && 'justify-center text-center',
					]}>
						{logo && (
							<div class:list={['relative flex w-36 shrink-0 items-center justify-center', fourColumns && 'xl:h-16 xl:w-full']} aria-hidden="true">
								<span
									class:list={[logo.className, 'absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-[color-mix(in_srgb,var(--cat-accent)_65%,white)] opacity-100 transition-opacity duration-200 group-hover:opacity-0 motion-reduce:transition-none']}
									style={`mask-image: url("${logo.src.src}"); -webkit-mask-image: url("${logo.src.src}"); mask-position: center; -webkit-mask-position: center; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-size: contain; -webkit-mask-size: contain;`}
								></span>
								{logo.isSvg ? (
									<img
										src={logo.src.src}
										alt=""
										width={logo.width}
										height={logo.width}
										loading="lazy"
										decoding="async"
										class:list={[
											logo.className,
											'object-contain opacity-0 transition-opacity duration-200 group-hover:opacity-100 motion-reduce:transition-none',
										]}
									/>
								) : (
									<OptimizedImage
										src={logo.src}
										alt=""
										width={logo.width}
										layout="constrained"
										fit="contain"
										loading="lazy"
										class:list={[
											logo.className,
											'object-contain opacity-0 transition-opacity duration-200 group-hover:opacity-100 motion-reduce:transition-none',
										]}
									/>
								)}
							</div>
						)}
						<div>
							<strong class="block text-lg leading-tight font-semibold text-ink md:text-xl">{item.name}</strong>
							{item.role && <span class="mt-1.5 block text-sm leading-relaxed text-ink-secondary md:text-base">{item.role}</span>}
						</div>
					</li>
				);
			})}
		</ul>

		{repeatHeaderAfterTiles && (
			<MethodologiesDivider />
		)}
	</aside>
)}
