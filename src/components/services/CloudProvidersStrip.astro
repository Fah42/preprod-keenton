---
import {
	siAmazonwebservices,
	siOvh,
	siScaleway,
} from 'simple-icons';
import OptimizedImage from '../ui/OptimizedImage.astro';
import MethodologiesDivider from './MethodologiesDivider.astro';
import azureLogo from '../../assets/images/cloud-providers/microsoft-azure.webp';
import googleCloudLogo from '../../assets/images/cloud-providers/google-cloud.png';

const providers = [
	{ name: 'OVHcloud', icon: siOvh, french: true, color: '#123F6D' },
	{ name: 'Scaleway', icon: siScaleway, french: true, color: '#4F0599' },
	{ name: 'Microsoft Azure', image: azureLogo },
	{ name: 'Amazon Web Services', icon: siAmazonwebservices, color: '#232F3E' },
	{ name: 'Google Cloud', image: googleCloudLogo },
];
---

<aside class="mt-10 md:mt-12" aria-labelledby="cloud-providers-title">
	<header class="text-center">
		<div class="flex items-center gap-4">
			<span class="h-px flex-1 bg-linear-to-r from-transparent to-[color-mix(in_srgb,var(--cat-accent)_45%,transparent)]" aria-hidden="true"></span>
			<h2 id="cloud-providers-title" class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-[var(--cat-accent)]">
				Clouds maîtrisés
			</h2>
			<span class="h-px flex-1 bg-linear-to-l from-transparent to-[color-mix(in_srgb,var(--cat-accent)_45%,transparent)]" aria-hidden="true"></span>
		</div>
		<p class="mx-auto mt-3 max-w-2xl text-sm text-ink-secondary">
			Les principaux hyperscalers français et internationaux, maîtrisés par nos équipes.
		</p>
	</header>

	<ul class="-mx-6 mt-6 flex snap-x gap-3 overflow-x-auto px-6 pb-1 lg:mx-0 lg:grid lg:grid-cols-5 lg:overflow-visible lg:px-0 lg:pb-0" aria-label="Fournisseurs de cloud maîtrisés">
		{
			providers.map((provider) => (
				<li
					class:list={[
						'group w-48 shrink-0 snap-start rounded-xl p-[2px] lg:w-auto',
						provider.french
							? 'bg-[linear-gradient(110deg,#0055A4_0%,#0055A4_31%,#ffffff_46%,#ffffff_54%,#EF4135_69%,#EF4135_100%)]'
							: 'bg-line',
					]}
				>
					<div class="flex min-h-28 flex-col items-center justify-center gap-3 rounded-[calc(0.75rem-2px)] bg-white px-4 py-5 md:min-h-32">
						{provider.image ? (
							<div class="relative h-12 w-16 shrink-0">
								<span
									class="absolute inset-0 bg-[color-mix(in_srgb,var(--cat-accent)_65%,white)] opacity-100 transition-opacity duration-200 group-hover:opacity-0 motion-reduce:transition-none"
									style={`mask-image: url("${provider.image.src}"); -webkit-mask-image: url("${provider.image.src}"); mask-position: center; -webkit-mask-position: center; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-size: contain; -webkit-mask-size: contain;`}
									aria-hidden="true"
								></span>
								<OptimizedImage
									src={provider.image}
									alt=""
									width={64}
									layout="fixed"
									class="h-12 w-16 object-contain opacity-0 transition-opacity duration-200 group-hover:opacity-100 motion-reduce:transition-none"
									loading="lazy"
								/>
							</div>
						) : (
							<svg
								viewBox="0 0 24 24"
								class="h-12 w-16 shrink-0 fill-current text-[color-mix(in_srgb,var(--cat-accent)_65%,white)] transition-colors duration-200 group-hover:text-[var(--brand-color)] motion-reduce:transition-none"
								style={`--brand-color: ${provider.color}`}
								aria-hidden="true"
							>
								<path d={provider.icon.path} />
							</svg>
						)}
						<strong class="text-center text-base leading-tight font-semibold text-ink">{provider.name}</strong>
					</div>
				</li>
			))
		}
	</ul>
	<MethodologiesDivider />
</aside>
