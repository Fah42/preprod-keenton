---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Icon from '../components/ui/Icon.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import RecruitmentContactForm from '../components/contact/RecruitmentContactForm.vue';
import { recruitmentRoles } from '../data/recruitment.js';

const formRoles = [
	...recruitmentRoles.map((role) => ({ label: role.title, value: role.title })),
	{ label: 'Candidature spontanée', value: 'Candidature spontanée' },
];
---

<BaseLayout
	title="Candidature spontanée | Rejoindre Keenton"
	description="Présentez votre parcours, vos compétences et vos envies à l’équipe Keenton pour rejoindre nos métiers de l’informatique et construire la suite avec nous."
	ogImage="/images/recrutement-pennywise.png"
>
	<section class="relative overflow-hidden border-b border-line bg-surface">
		<div class="bg-grid-light pointer-events-none absolute inset-0 [mask-image:radial-gradient(42rem_24rem_at_78%_35%,black,transparent_76%)]" aria-hidden="true"></div>
		<div class="pointer-events-none absolute -right-28 -top-40 h-96 w-96 rounded-full bg-accent/8 blur-3xl" aria-hidden="true"></div>

		<Container class="relative py-14 md:py-20">
			<a href="/recrutement" class="inline-flex items-center gap-2 text-sm font-semibold text-accent-dark transition-colors hover:text-accent">
				<span aria-hidden="true">←</span>
				Retour au recrutement
			</a>

			<div class="mt-10 grid items-center gap-10 lg:grid-cols-[0.96fr_1.04fr] lg:gap-16">
				<header>
					<p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-dark">Candidature</p>
					<h1 class="mt-5 max-w-2xl text-4xl font-bold leading-tight text-ink md:text-5xl">
						Parlons de vous avant de parler de poste.
					</h1>
				</header>

				<figure class="overflow-hidden rounded-2xl border border-line bg-footer-from shadow-cold-lg">
					<OptimizedImage
						src="/images/recrutement-pennywise.png"
						alt="Mème humoristique invitant à rejoindre Keenton"
						width={800}
						layout="constrained"
						fit="cover"
						loading="eager"
						fetchpriority="high"
						class="aspect-[8/5] w-full object-cover"
					/>
					<figcaption class="flex items-center justify-between gap-4 border-t border-white/15 px-5 py-4 text-sm text-white/80">
						<span>On prend la technique au sérieux.</span>
						<span class="font-semibold text-white">Pas toujours nous-mêmes.</span>
					</figcaption>
				</figure>
			</div>
		</Container>
	</section>

	<section class="bg-surface-alt py-14 md:py-20">
		<Container class="grid items-start gap-8 lg:grid-cols-[0.68fr_1.32fr] lg:gap-12 xl:gap-16">
			<aside class="order-2 space-y-5 lg:order-1 lg:sticky lg:top-28">
				<div class="relative overflow-hidden rounded-2xl bg-footer-from p-7 text-white shadow-cold-lg md:p-8">
					<div class="bg-grid-dark pointer-events-none absolute inset-0 [mask-image:radial-gradient(28rem_20rem_at_20%_10%,black,transparent_80%)]" aria-hidden="true"></div>
					<div class="relative">
						<h2 class="text-2xl font-semibold text-white">Un échange concret, pas un exercice de style.</h2>
						<p class="mt-4 leading-relaxed text-white/75">
							Nous voulons surtout comprendre votre terrain de jeu, votre manière de travailler et la prochaine étape que vous souhaitez franchir.
						</p>

						<ul class="mt-7 space-y-4">
							<li class="flex gap-3">
								<Icon name="check-circle" class="mt-0.5 h-5 w-5 shrink-0 text-accent-light" />
								<span class="text-sm leading-relaxed text-white/85">Le type de rôle ou d’environnement qui vous attire.</span>
							</li>
							<li class="flex gap-3">
								<Icon name="check-circle" class="mt-0.5 h-5 w-5 shrink-0 text-accent-light" />
								<span class="text-sm leading-relaxed text-white/85">Votre disponibilité et votre mobilité.</span>
							</li>
							<li class="flex gap-3">
								<Icon name="check-circle" class="mt-0.5 h-5 w-5 shrink-0 text-accent-light" />
								<span class="text-sm leading-relaxed text-white/85">Ce que vous voulez construire ou apprendre avec nous.</span>
							</li>
						</ul>
					</div>
				</div>

				<div class="rounded-2xl border border-accent/30 bg-accent/8 p-6">
					<Icon name="lightbulb" class="h-6 w-6 text-accent-dark" />
					<h2 class="mt-4 font-semibold text-ink">Vous ne cochez pas toutes les cases ?</h2>
					<p class="mt-2 text-sm leading-relaxed text-ink-secondary">
						Une candidature spontanée reste bienvenue. Les parcours atypiques peuvent apporter exactement ce que nous n’avions pas pensé à chercher.
					</p>
				</div>
			</aside>

			<div class="order-1 rounded-2xl border border-line bg-surface p-6 shadow-cold md:p-10 lg:order-2">
				<header class="border-b border-line pb-7">
					<h2 class="text-2xl font-bold text-ink">Présentez-vous simplement.</h2>
					<p class="mt-3 max-w-2xl leading-relaxed text-ink-secondary">
						Donnez-nous quelques repères sur votre parcours et vos envies. L’équipe prendra le temps de vous lire.
					</p>
				</header>

				<div class="mt-8">
					<RecruitmentContactForm roles={formRoles} client:load />
				</div>
			</div>
		</Container>
	</section>
</BaseLayout>
